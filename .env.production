# Production webview build (packaged Tauri app). The Tauri shell binds an
# ephemeral loopback port and injects the absolute API base into the window
# (`window.__EARTMP_API_BASE__`) before the app loads, so no fixed base is baked
# here. Left blank intentionally; the injected global is the source of truth.
# See docs/packaging-runbook.md and src/presentation/runtime/ipcClient.ts.
VITE_API_BASE=
