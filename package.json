{
  "name": "eartmp-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EduCore Academic Records & Transcript Management Platform — domain core",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "demo:login": "tsx scripts/demo-login.ts",
    "demo:settings": "tsx scripts/demo-settings.ts",
    "demo:grading": "tsx scripts/demo-grading.ts",
    "demo:structure": "tsx scripts/demo-structure.ts",
    "demo:records": "tsx scripts/demo-records.ts",
    "demo:persistence": "tsx scripts/demo-persistence.ts",
    "demo:config": "tsx scripts/demo-config.ts",
    "demo:results": "tsx scripts/demo-results.ts",
    "demo:import": "tsx scripts/demo-import.ts",
    "demo:summary": "tsx scripts/demo-summary.ts",
    "demo:transcript": "tsx scripts/demo-transcript.ts",
    "demo:pdf": "tsx scripts/demo-pdf.ts",
    "demo:docx": "tsx scripts/demo-docx.ts",
    "demo:template": "tsx scripts/demo-template.ts",
    "demo:graduation": "tsx scripts/demo-graduation.ts",
    "demo:backup": "tsx scripts/demo-backup.ts",
    "demo:security": "tsx scripts/demo-security.ts",
    "demo:audit": "tsx scripts/demo-audit.ts",
    "demo:e2e": "tsx scripts/demo-e2e.ts",
    "host:smoke": "tsx scripts/host-smoke.ts",
    "host:serve": "tsx src/host/server.ts",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "dev": "tsx scripts/dev.ts",
    "prepare": "husky || true"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/pdfmake": "^0.2.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.0",
    "docx": "^8.5.0",
    "pdfmake": "^0.2.10",
    "prisma": "^6.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "^0.18.5"
  }
}
