// EduCore (EARTMP) — Prisma schema
// SQLite, offline-first. Every table carries createdAt / updatedAt / deletedAt
// (soft delete) per SDP section 6.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth & RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // SUPER_ADMIN, REGISTRAR, ...
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
}

model Permission {
  id        String           @id @default(cuid())
  key       String           @unique // e.g. "students.create"
  label     String
  roles     RolePermission[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  fullName     String
  passwordHash String // Argon2
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Institution & settings
// ---------------------------------------------------------------------------

model Institution {
  id                   String    @id @default(cuid())
  name                 String
  motto                String?
  accreditationNo      String?
  address              String?
  telephone            String?
  email                String?
  website              String?
  logoPath             String?
  sealPath             String?
  registrarSignPath    String?
  calendarType         String    @default("SEMESTER") // SEMESTER | TRIMESTER | QUARTER
  transcriptNumberRule String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
}

model Setting {
  id        String    @id @default(cuid())
  key       String    @unique
  value     String // JSON-encoded
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

// NOTE: `code` / `name` here are NOT `@unique` at the column level. Phase 5
// (ADR-010 / F-20) enforces uniqueness among LIVE rows only via raw partial
// unique indexes (`WHERE deletedAt IS NULL`) added in the migration, so a
// soft-deleted code can be re-used. Repositories use findFirst, not findUnique.
model Faculty {
  id          String       @id @default(cuid())
  name        String
  code        String
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
}

model Department {
  id             String          @id @default(cuid())
  name           String
  code           String
  facultyId      String
  faculty        Faculty         @relation(fields: [facultyId], references: [id])
  subDepartments SubDepartment[]
  programmes     Programme[]
  courses        Course[]
  students       Student[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@index([facultyId])
}

// Optional organizational unit under a Department (AD: configurable hierarchy).
// Programmes, courses and students may belong directly to a department or to one
// of its sub-departments.
model SubDepartment {
  id           String      @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  programmes   Programme[]
  courses      Course[]
  students     Student[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  @@index([departmentId])
}

model Programme {
  id              String              @id @default(cuid())
  name            String
  code            String
  departmentId    String
  department      Department          @relation(fields: [departmentId], references: [id])
  subDepartmentId String?
  subDepartment   SubDepartment?      @relation(fields: [subDepartmentId], references: [id])
  durationLevels  Int                 @default(4)
  creditsRequired Int                 @default(0)
  levels          Level[]
  students        Student[]
  courses         Course[]
  enrollments     StudentEnrollment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  @@index([departmentId])
  @@index([subDepartmentId])
}

model Level {
  id           String              @id @default(cuid())
  name         String // e.g. "100", "200"
  rank         Int // ordering
  programmeId  String
  programme    Programme           @relation(fields: [programmeId], references: [id])
  // Per-level grade scale (configurable grading per level of study). Loose ref
  // (no FK) so the level survives a grade-scale deletion, like Result provenance;
  // null falls back to the institution default scale.
  gradeScaleId String?
  students     Student[]
  courses      Course[]
  enrollments  StudentEnrollment[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  @@index([programmeId])
}

model AcademicSession {
  id        String     @id @default(cuid())
  name      String // e.g. "2025/2026"
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean    @default(false)
  semesters Semester[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
}

model Semester {
  id        String          @id @default(cuid())
  name      String // e.g. "First Semester"
  rank      Int
  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id])
  results   Result[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  @@unique([sessionId, rank])
}

// ---------------------------------------------------------------------------
// Students & courses
// ---------------------------------------------------------------------------

model Student {
  id               String              @id @default(cuid())
  matricNumber     String
  regNumber        String?
  fullName         String
  gender           String?
  dateOfBirth      DateTime?
  nationality      String?
  address          String?
  telephone        String?
  email            String?
  photoPath        String?
  facultyId        String?
  departmentId     String?
  department       Department?         @relation(fields: [departmentId], references: [id])
  subDepartmentId  String?
  subDepartment    SubDepartment?      @relation(fields: [subDepartmentId], references: [id])
  programmeId      String?
  programme        Programme?          @relation(fields: [programmeId], references: [id])
  levelId          String?
  level            Level?              @relation(fields: [levelId], references: [id])
  admissionSession String?
  status           String              @default("ACTIVE") // ACTIVE|SUSPENDED|DEFERRED|WITHDRAWN|GRADUATED
  version          Int                 @default(0) // optimistic concurrency (F-27)
  results          Result[]
  transcripts      Transcript[]
  enrollments      StudentEnrollment[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  @@index([departmentId])
  @@index([programmeId, levelId])
}

// Historizes a student's programme/level over time (transfers, progression).
// F-22. Use-cases land in Phase 6; the table is provisioned here.
model StudentEnrollment {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])
  levelId     String
  level       Level     @relation(fields: [levelId], references: [id])
  fromSession String
  toSession   String?
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([studentId])
  @@index([programmeId])
  @@index([levelId])
}

model Course {
  id              String         @id @default(cuid())
  code            String
  title           String
  creditValue     Int
  courseType      String         @default("CORE") // CORE|ELECTIVE|PRACTICAL|CLINICAL
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])
  subDepartmentId String?
  subDepartment   SubDepartment? @relation(fields: [subDepartmentId], references: [id])
  programmeId     String?
  programme       Programme?     @relation(fields: [programmeId], references: [id])
  levelId         String?
  level           Level?         @relation(fields: [levelId], references: [id])
  semesterRank    Int? // which semester in the level
  results         Result[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@index([programmeId])
  @@index([departmentId])
  @@index([subDepartmentId])
  @@index([levelId])
}

// ---------------------------------------------------------------------------
// Assessment & grading config
// ---------------------------------------------------------------------------

model AssessmentType {
  id        String    @id @default(cuid())
  key       String    @unique // "ca", "exam"
  label     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// A named assessment structure; components stored as JSON for flexibility.
model AssessmentConfig {
  id         String    @id @default(cuid())
  name       String    @unique
  components String // JSON: [{key,label,weight,maxScore}]
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

// A named grade scale; bands stored as JSON.
model GradeScale {
  id        String    @id @default(cuid())
  name      String    @unique
  bands     String // JSON: [{minMark,maxMark,grade,gradePoint,isPass}]
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ---------------------------------------------------------------------------
// Results
// ---------------------------------------------------------------------------

model Result {
  id                 String    @id @default(cuid())
  studentId          String
  student            Student   @relation(fields: [studentId], references: [id])
  courseId           String
  course             Course    @relation(fields: [courseId], references: [id])
  semesterId         String
  semester           Semester  @relation(fields: [semesterId], references: [id])
  componentScores    String // JSON: [{key,score}]
  finalScore         Float?
  grade              String?
  gradePoint         Float?
  creditsEarned      Int?
  // Provenance (F-19): which config produced this grade, so historical grades
  // remain reproducible even if the default config changes later. Loose ids
  // (no FK) so the record survives config deletion, like the audit log.
  gradeScaleId       String?
  assessmentConfigId String?
  isLocked           Boolean   @default(false)
  version            Int       @default(0) // optimistic concurrency (F-27)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@unique([studentId, courseId, semesterId])
  @@index([studentId, semesterId])
  @@index([studentId])
  @@index([courseId, semesterId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Transcripts & templates
// ---------------------------------------------------------------------------

model TranscriptTemplate {
  id          String       @id @default(cuid())
  name        String       @unique
  version     Int          @default(1)
  layout      String // JSON: ordered component definitions
  isDefault   Boolean      @default(false)
  transcripts Transcript[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
}

model Transcript {
  id               String             @id @default(cuid())
  transcriptNumber String             @unique
  studentId        String
  student          Student            @relation(fields: [studentId], references: [id])
  templateId       String
  template         TranscriptTemplate @relation(fields: [templateId], references: [id])
  type             String             @default("ACADEMIC_TRANSCRIPT") // RESULT_SLIP|ACADEMIC_TRANSCRIPT|STATEMENT|GRADUATION_REPORT
  snapshot         String // JSON: frozen rendered data
  verificationHash String
  status           String             @default("DRAFT") // DRAFT|APPROVED|LOCKED
  remarks          String?
  version          Int                @default(0) // optimistic concurrency (F-27)
  generatedAt      DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Audit, backup, notifications
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // CREATE|UPDATE|DELETE|LOGIN|EXPORT...
  entity    String
  recordId  String?
  oldValue  String? // JSON
  newValue  String? // JSON
  ipAddress String?
  createdAt DateTime @default(now())
  // Tamper-evident hash chain (Phase 19). Nullable: pre-chain rows are
  // "unchained", not broken. hash = SHA-256(prevHash + canonical payload).
  prevHash  String?
  hash      String?
  // No updatedAt/deletedAt: audit logs are append-only and immutable.

  @@index([entity, recordId])
  @@index([createdAt])
}

model Backup {
  id           String    @id @default(cuid())
  filePath     String
  sizeBytes    Int?
  type         String    @default("MANUAL") // MANUAL|AUTOMATIC|SCHEDULED
  schedule     String? // DAILY|WEEKLY|MONTHLY
  isCompressed Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  body      String?
  level     String    @default("INFO") // INFO|WARNING|ERROR
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}
